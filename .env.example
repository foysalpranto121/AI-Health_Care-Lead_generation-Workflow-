# Copy this file to .env and fill in your own values. .env is git-ignored - never commit it.
# Any value that still contains YOUR_ is treated as "not configured".

# --- OpenAI (PAID) - required for AI decision-maker extraction & cold-email writing ---
# Create at https://platform.openai.com/api-keys  (starts with sk-proj-... or sk-...)
# Leave the placeholder to run lead_generator.py in free offline mode (rule-based parser).
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# --- Telegram lead alerts (FREE, optional) ---
# Bot token: message @BotFather -> /newbot        (format 123456789:ABCdef...)
# Chat ID:   message @userinfobot, or add the bot to a group and use the group's ID (negative number)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# Per-lead alerts only for leads whose offer fit score (1-5, from offer.md) is at least this. 0 = alert on every lead.
# The end-of-run summary (counts, sources, fit distribution, top leads) is always sent.
TELEGRAM_MIN_FIT=0

# --- Optional: Google Programmable Search (FREE, 100 queries/day) for reliable decision-maker lookups ---
# Bing / DuckDuckGo throttle automated searches; Google's JSON API does not and honours site:linkedin.com/in.
# 1. https://programmablesearchengine.google.com -> Add -> "Search the entire web" -> copy the Search engine ID (cx)
# 2. https://console.cloud.google.com -> enable "Custom Search API" -> Credentials -> API key
# GOOGLE_CSE_KEY=YOUR_GOOGLE_API_KEY
# GOOGLE_CSE_CX=YOUR_SEARCH_ENGINE_ID

# --- Optional tuning ---
# OPENAI_MODEL=gpt-4o-mini          # any chat model with JSON mode
# OFFER_FILE=offer.md               # path to your offer brief (default: offer.md next to the script)

# Google Sheets is only used by the n8n workflow, which reads the Sheet ID from node 11
# and authenticates with an n8n Google Sheets credential - nothing to configure here.
